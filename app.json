{
  "expo": {
    "name": "ApulkiMess",
    "slug": "ApulkiMess",
    "scheme": "apulkimess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ApulkiMess"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground-1024.png",
        "backgroundImage": "./assets/android-icon-background-1024.png",
        "monochromeImage": "./assets/android-icon-monochrome-1024.png"
      },

      "package": "com.anonymous.ApulkiMess"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9F4",
          "image": "./assets/splash-icon-1024.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
